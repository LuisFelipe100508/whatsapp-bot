# Copie para .env e preencha. NUNCA commite o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# Meta Cloud API
WHATSAPP_VERIFY_TOKEN=invente-um-token-longo-e-aleatorio
WHATSAPP_APP_SECRET=app-secret-do-painel-da-meta
WHATSAPP_ACCESS_TOKEN=token-da-meta

# Cron externo dos lembretes
REMINDER_CRON_TOKEN=outro-token-longo-e-aleatorio

# Gmail (use SENHA DE APP, não a senha da conta)
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=senha-de-app-de-16-caracteres
# Caminho do painel admin. Em produção troque por algo como painel-x7k2/
ADMIN_URL=admin/
NUM_PROXIES=0
LOG_LEVEL=INFO